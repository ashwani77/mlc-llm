# MLC-LLM CI/CD Docker Image with CUDA Support
# Multi-purpose: Development environment + Build environment
# Follows official MLC-LLM "Option 2: Build from Source" with CUDA enabled

FROM nvidia/cuda:12.1.1-devel-ubuntu22.04

# =============================================================================
# ENVIRONMENT SETUP
# =============================================================================

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=UTC \
    MLC_LLM_SOURCE_DIR=/workspace/mlc-llm \
    PYTHONPATH=/workspace/mlc-llm/python:${PYTHONPATH} \
    CUDA_HOME=/usr/local/cuda-12.1 \
    PATH=/usr/local/cuda-12.1/bin:${PATH} \
    LD_LIBRARY_PATH=/usr/local/cuda-12.1/lib64:${LD_LIBRARY_PATH}

RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# =============================================================================
# STEP 1: INSTALL CUDA DEPENDENCIES (cuDNN, etc.)
# =============================================================================

# Install cuDNN and other CUDA libraries
RUN apt-get update && apt-get install -y \
    libcudnn8 \
    libcudnn8-dev \
    && rm -rf /var/lib/apt/lists/*

# =============================================================================
# STEP 2: INSTALL BUILD DEPENDENCIES
# =============================================================================

RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    git \
    wget \
    curl \
    python3.11 \
    python3.11-dev \
    python3-pip \
    software-properties-common \
    gnupg2 \
    ca-certificates \
    vim \
    nano \
    htop \
    && rm -rf /var/lib/apt/lists/*

# Set Python 3.11 as default
RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1 && \
    update-alternatives --install /usr/bin/python python /usr/bin/python3.11 1

# Upgrade pip
RUN python -m pip install --upgrade pip setuptools wheel

# Install Rust and Cargo
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

# Install LLVM 17
RUN wget https://apt.llvm.org/llvm.sh && \
    chmod +x llvm.sh && \
    ./llvm.sh 17 && \
    rm llvm.sh

ENV LLVM_CONFIG=/usr/bin/llvm-config-17 \
    LLVM_HOME=/usr/lib/llvm-17 \
    PATH=/usr/lib/llvm-17/bin:${PATH}

# =============================================================================
# STEP 3: CLONE MLC-LLM REPOSITORY
# =============================================================================

WORKDIR /workspace

RUN git clone --recursive https://github.com/mlc-ai/mlc-llm.git && \
    cd mlc-llm && \
    echo "MLC-LLM cloned at commit: $(git rev-parse HEAD)"

# =============================================================================
# STEP 4: INSTALL PYTHON DEPENDENCIES
# =============================================================================

WORKDIR /workspace/mlc-llm

RUN pip install --no-cache-dir \
    numpy \
    torch \
    transformers \
    attrs \
    decorator \
    psutil \
    typing_extensions \
    pytest \
    pytest-cov \
    packaging

# Install TVM with CUDA support
RUN pip install --pre -U -f https://mlc.ai/wheels mlc-ai-nightly-cu121

# =============================================================================
# STEP 5: CONFIGURE AND BUILD MLC-LLM WITH CUDA
# =============================================================================

RUN mkdir -p build

WORKDIR /workspace/mlc-llm/build

# Generate build configuration with CUDA ENABLED
RUN python ../cmake/gen_cmake_config.py << 'EOF'
y
y
y
n
n
n
n
EOF

# Run CMake configuration
RUN cmake .. && \
    echo "✓ CMake configuration completed"

# Build MLC-LLM libraries with limited parallelism
RUN make -j4 && \
    echo "✓ MLC-LLM libraries built successfully with CUDA support"

# Verify build outputs
RUN ls -lh libmlc_llm.so libtvm_runtime.so && \
    echo "✓ Build artifacts verified"

# =============================================================================
# STEP 6: INSTALL MLC-LLM PYTHON PACKAGE
# =============================================================================

WORKDIR /workspace/mlc-llm/python

RUN pip install -e . && \
    echo "✓ MLC-LLM Python package installed"

# =============================================================================
# STEP 7: VALIDATE INSTALLATION
# =============================================================================

WORKDIR /workspace

RUN mlc_llm --help && \
    echo "✓ MLC-LLM CLI verified"

RUN python -c "import mlc_llm; print('MLC-LLM version:', mlc_llm.__version__)" && \
    echo "✓ MLC-LLM Python import verified"

RUN python -c "import tvm; print('TVM library:', tvm.__file__)" && \
    echo "✓ TVM library verified"

# Verify CUDA is detected (will show False in build, True at runtime with GPU)
RUN python -c "import torch; print('CUDA available (build):', torch.cuda.is_available())" || \
    echo "⚠ CUDA runtime not available (normal during build, will work with --gpus at runtime)"

# =============================================================================
# MULTI-PURPOSE ENTRYPOINT
# =============================================================================

COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD []

# =============================================================================
# METADATA
# =============================================================================

LABEL org.opencontainers.image.source="https://github.com/mlc-ai/mlc-llm" \
      org.opencontainers.image.description="MLC-LLM Docker image with CUDA 12.1 support" \
      org.opencontainers.image.version="1.0-cuda" \
      org.opencontainers.image.licenses="Apache-2.0" \
      maintainer="MLC-LLM CI/CD Pipeline" \
      cuda.version="12.1.1"
